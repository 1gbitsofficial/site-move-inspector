{
  "name": "1gbits/site-move-inspector",
  "description": "Development tools for the cross-platform Site Move Inspector repository.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "build:joomla": "powershell -ExecutionPolicy Bypass -File scripts/build-joomla-release.ps1",
    "build:wordpress": "powershell -ExecutionPolicy Bypass -File scripts/build-wordpress-release.ps1",
    "lint": "phpcs --standard=apps/wordpress/phpcs.xml.dist",
    "lint:joomla": "powershell -ExecutionPolicy Bypass -File scripts/test-joomla-package.ps1",
    "lint:wordpress": "phpcs --standard=apps/wordpress/phpcs.xml.dist",
    "test": "phpunit --configuration=apps/wordpress/phpunit.xml.dist",
    "test:all": [
      "@test:wordpress",
      "@test:joomla"
    ],
    "test:joomla": "phpunit --configuration=apps/joomla/phpunit.xml.dist",
    "test:wordpress": "phpunit --configuration=apps/wordpress/phpunit.xml.dist"
  }
}
